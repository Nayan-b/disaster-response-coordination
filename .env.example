# Copy to .env and adjust. Every value has a working default, so `docker compose up --build`
# runs without creating this file at all.

# --- LLM provider (all optional) ---------------------------------------------
# With no provider the graph drafts with the deterministic rule-based engine, and the whole
# pipeline — fact-check and approval gate included — still works end to end.
#
# Leave FLOOD_LLM_PROVIDER blank to auto-detect: ANTHROPIC_API_KEY is preferred when both are set,
# because the direct path has fewer hops. Set it to `openrouter` to force the gateway, or `none`
# to pin the rule-based engine even with keys present.
FLOOD_LLM_PROVIDER=

# Option 1 — Anthropic direct.
ANTHROPIC_API_KEY=
FLOOD_CLAUDE_MODEL=claude-opus-5

# Option 2 — OpenRouter (one key, 400+ models). Model ids are vendor-namespaced, e.g.
# anthropic/claude-opus-5, openai/gpt-5.2, google/gemini-2.5-pro. Pick one that supports
# structured outputs — the drafting step needs schema-constrained JSON.
OPENROUTER_API_KEY=
FLOOD_OPENROUTER_MODEL=openai/gpt-5.6-luna

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=flood
POSTGRES_PASSWORD=flood
POSTGRES_DB=flood
POSTGRES_PORT=55432

# --- Ports -------------------------------------------------------------------
BACKEND_PORT=8088
FRONTEND_PORT=3000

# --- Wiring ------------------------------------------------------------------
# Baked into the browser bundle at build time, so it must be the host-reachable URL. If you change
# BACKEND_PORT, change this too, and rebuild the frontend image (`--build`).
NEXT_PUBLIC_API_BASE=http://localhost:8088

# Origins allowed to call the API from a browser.
FLOOD_CORS_ORIGINS=http://localhost:3000
