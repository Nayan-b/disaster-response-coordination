# Local runtime state. Everything under data/ is generated and reproducible: the API response and
# raster cache (~114 MB, re-fetched on demand) and the SQLite checkpoint store holding paused runs.
data/

# Checkpoint databases written anywhere else (FLOOD_CHECKPOINT_DB can point outside data/).
# The -wal and -shm siblings are live SQLite journals — committing one mid-write stores a torn DB.
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env
.env
.env.local

# Personal Claude Code settings — machine-specific, not project config.
.claude/settings.local.json

# OS
.DS_Store

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
